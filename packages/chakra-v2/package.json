{
  "name": "@chakra-v2/querybuilder",
  "description": "Custom Chakra UI (v2 fork) components for react-querybuilder",
  "version": "6.5.5",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/react-querybuilder_chakra.legacy-esm.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/react-querybuilder_chakra.d.mts",
        "default": "./dist/react-querybuilder_chakra.mjs"
      },
      "require": {
        "types": "./dist/cjs/react-querybuilder_chakra.cjs.development.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/react-querybuilder_chakra.d.mts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/react-querybuilder/react-querybuilder.git",
    "directory": "packages/chakra"
  },
  "license": "MIT",
  "homepage": "https://react-querybuilder.js.org/",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "devDependencies": {
    "@chakra-v2/icons": "3.0.0-next.0",
    "@chakra-v2/react": "2.11.0-next.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.18",
    "framer-motion": "^10.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-querybuilder": "^6.5.5",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@chakra-v2/icons": "*",
    "@chakra-v2/react": "*",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "framer-motion": "^6.3.3",
    "react": ">=18.1.0",
    "react-querybuilder": "^6.5.5"
  }
}
